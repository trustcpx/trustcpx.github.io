<div class="scroll-story" data-scroll-story>
  <div class="scroll-story-copy">
    <p class="eyebrow">The two-stage path</p>
    <h3>Every object earns its way into the shared scene.</h3>
    <p>Local trust scores the report itself. Global trust scores the sender over time. The gate then decides whether that evidence can affect the fused output.</p>
  </div>
  <div class="scroll-pipeline" aria-label="Animated TrustCPX pipeline">
    <div class="pipeline-progress"><span data-pipeline-progress></span></div>
    <div class="pipeline-node is-active" data-pipeline-node="0"><span>01</span><strong>Detect + track</strong><small>Object-level evidence</small></div>
    <div class="pipeline-arrow">↓</div>
    <div class="pipeline-node" data-pipeline-node="1"><span>02</span><strong>Local trust</strong><small>14 complementary factors → LTS</small></div>
    <div class="pipeline-arrow">↓</div>
    <div class="pipeline-node" data-pipeline-node="2"><span>03</span><strong>Global judging</strong><small>Corroboration + reputation update</small></div>
    <div class="pipeline-arrow">↓</div>
    <div class="pipeline-node" data-pipeline-node="3"><span>04</span><strong>Gate + fuse</strong><small>Admit, withhold, or weight</small></div>
  </div>
</div>

<script>
  // @ts-nocheck
  const story = document.querySelector('[data-scroll-story]');
  if (story) {
    const nodes = Array.from(story.querySelectorAll('[data-pipeline-node]'));
    const progress = story.querySelector('[data-pipeline-progress]');
    const updateStory = () => {
      const rect = story.getBoundingClientRect();
      const progressValue = Math.min(1, Math.max(0, (window.innerHeight * 0.72 - rect.top) / Math.max(1, rect.height - window.innerHeight * 0.28)));
      const active = Math.min(nodes.length - 1, Math.floor(progressValue * nodes.length));
      nodes.forEach((node, index) => {
        node.classList.toggle('is-active', index === active);
        node.classList.toggle('is-seen', index <= active);
      });
      if (progress) progress.style.height = `${Math.max(25, (active + 1) / nodes.length * 100)}%`;
    };
    window.addEventListener('scroll', updateStory, { passive: true });
    window.addEventListener('resize', updateStory);
    updateStory();
  }
</script>
